# Neon Postgres - Obtener de https://neon.tech
DATABASE_URL=postgres://user:password@host.neon.tech/dbname?sslmode=require

# Vercel Blob - Se configura automáticamente al crear un Blob store en Vercel
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx

# Multi-tenant
# El dominio base para los subdominios de cada tenant
BASE_DOMAIN=flexio.cl

# Resend - Emails transaccionales (https://resend.com)
RESEND_API_KEY=re_xxxxx
NOTIFICATION_FROM_EMAIL=notificaciones@flexio.cl

# Admin global (para gestión de tenants)
GLOBAL_ADMIN_SECRET=cambiar-por-algo-seguro

# MercadoPago - Suscripciones (https://www.mercadopago.cl/developers)
MP_ACCESS_TOKEN=APP_USR-xxxxx
MP_PLAN_BASICO_ID=
MP_PLAN_PROFESIONAL_ID=
MP_PLAN_ENTERPRISE_ID=

# URL base de la app (para redirects de MercadoPago)
BASE_URL=https://flexio.cl

# Sello de Tiempo (Resolución 38 DT) - Secreto para HMAC de sellos
# IMPORTANTE: Generar un valor único y seguro. No cambiar una vez en producción.
TIMESTAMP_SECRET=generar-secreto-seguro-aleatorio-64chars

# Google Maps API (opcional - para reverse geocoding más preciso)
GOOGLE_MAPS_API_KEY=
